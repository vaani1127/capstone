# Application Settings
PROJECT_NAME=HealthSaathi API
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Database Configuration
# For Render, use: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://healthsaathi_user:YOUR_PASSWORD@localhost:5432/healthsaathi

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=GENERATE_RANDOM_32_CHAR_HEX_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (Required for production)
# Add your Vercel frontend URL here
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Server Configuration
HOST=0.0.0.0
PORT=8000
