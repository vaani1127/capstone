+"""
+Resource-Efficiency Benchmark: IsolationForest vs One-Class SVM vs Compact Autoencoder
+========================================================================================
+
+Novelty contribution: the anomaly-detection literature for EHR audit logs
+(Tabassum et al. 2024, Khalique et al. 2024, and the broader 2024-2026 survey
+literature) benchmarks models on accuracy/F1 alone. None benchmark *deployment
+cost* for the resource-constrained setting this project targets: a small or
+mid-sized Indian clinic running its own server, not a hospital-scale cluster
+with GPU inference.
+
+This script fills that gap. It trains three anomaly detectors on the SAME
+80% split (identical to ablation_study.py's leakage-free protocol) and
+reports, for each:
+  - Precision / Recall / F1 / FPR   (does it work?)
+  - Inference latency (ms per 1,000 predictions)   (can it run on weak hardware?)
+  - Trained model size on disk (KB)                (can it fit / ship easily?)
+  - Training time (seconds)                        (can it be retrained cheaply?)
+
+Models compared
+----------------
+  1. IsolationForest   - current production model (per-role, as in train.py)
+  2. One-Class SVM      - classic heavier unsupervised baseline (O(n^2)-ish
+                           kernel computation at train time)
+  3. Compact Autoencoder - sklearn MLPRegressor with a bottleneck hidden layer
+                           (8 -> 4 -> 8), reconstruction-error thresholding.
+                           Stands in for the "deep learning" direction the
+                           2026 survey literature points to (GNNs/transformers)
+                           without requiring a GPU or a new dependency (torch)
+                           that would itself contradict the low-resource thesis.
+
+Usage
+-----
+  cd project/backend
+  python resource_efficiency_benchmark.py
+  python resource_efficiency_benchmark.py --data ../../dataset/main_dataset/09_audit_logs_synthetic_extended.csv
+
+Honesty note
+------------
+This script prints only what it measures. If a model fails to converge or a
+role has too few samples, it is reported as N/A -never estimated or
+back-filled. Do not hand-edit the printed numbers into a report; re-run and
+paste the actual output.
+"""
+
+import argparse
+import sys
+import time
+import tracemalloc
+from pathlib import Path
+
+import joblib
+import numpy as np
+import pandas as pd
+from sklearn.ensemble import IsolationForest
+from sklearn.metrics import confusion_matrix, f1_score, precision_score, recall_score
+from sklearn.model_selection import train_test_split
+from sklearn.neural_network import MLPRegressor
+from sklearn.preprocessing import StandardScaler
+from sklearn.svm import OneClassSVM
+
+# ---------------------------------------------------------------------------
+# Paths - mirrors ablation_study.py exactly
+# ---------------------------------------------------------------------------
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+REPO_ROOT = SCRIPT_DIR.parent.parent
+
+_DEFAULT_DATA = REPO_ROOT / "dataset" / "main_dataset" / "09_audit_logs_synthetic.csv"
+_DEFAULT_MODELS_DIR = SCRIPT_DIR / "models_resource_benchmark"
+
+FEATURE_ORDER = [
+    "actions_per_hour",
+    "unique_patients_accessed",
+    "off_hours_flag",
+    "untreated_patient_ratio",
+    "record_type_entropy",
+    "rapid_edit_flag",
+    "cross_role_action_flag",
+    "session_duration_minutes",
+]
+
+ROLES_CSV = ["admin", "doctor", "nurse", "patient"]
+
+CONTAMINATION = 0.08     # matches train.py / ablation_study.py
+N_ESTIMATORS = 200       # matches train.py
+RANDOM_STATE = 42
+TEST_SIZE = 0.20
+N_LATENCY_TRIALS = 1000  # predictions timed per model for the latency figure
+
+
+# ---------------------------------------------------------------------------
+# Metric helpers (identical logic to ablation_study.py, kept in sync)
+# ---------------------------------------------------------------------------
+
+def compute_metrics(y_true: np.ndarray, y_pred: np.ndarray) -> dict:
+    if len(y_true) == 0 or y_true.sum() == len(y_true) or y_true.sum() == 0:
+        return {"precision": float("nan"), "recall": float("nan"),
+                "f1": float("nan"), "fpr": float("nan")}
+    try:
+        prec = precision_score(y_true, y_pred, zero_division=0)
+        rec = recall_score(y_true, y_pred, zero_division=0)
+        f1 = f1_score(y_true, y_pred, zero_division=0)
+    except Exception:
+        prec = rec = f1 = float("nan")
+    try:
+        tn, fp, fn, tp = confusion_matrix(y_true, y_pred, labels=[0, 1]).ravel()
+        fpr = fp / (fp + tn) if (fp + tn) > 0 else float("nan")
+    except Exception:
+        fpr = float("nan")
+    return {"precision": prec, "recall": rec, "f1": f1, "fpr": fpr}
+
+
+def fmt_pct(v: float) -> str:
+    return "  N/A " if np.isnan(v) else f"{v * 100:5.1f}%"
+
+
+def fmt_ms(v: float) -> str:
+    return "  N/A " if np.isnan(v) else f"{v:6.2f}"
+
+
+def fmt_kb(v: float) -> str:
+    return "  N/A " if np.isnan(v) else f"{v:7.1f}"
+
+
+# ---------------------------------------------------------------------------
+# Per-model training + measurement
+# ---------------------------------------------------------------------------
+
+def measure_model_size_kb(model, tmp_path: Path) -> float:
+    joblib.dump(model, tmp_path)
+    size_kb = tmp_path.stat().st_size / 1024.0
+    return size_kb
+
+
+def measure_inference_latency_ms(predict_fn, X_sample: np.ndarray, n_trials: int) -> float:
+    """Average ms per N_LATENCY_TRIALS predictions, single-row-at-a-time
+    (mirrors real-world usage: one audit event scored as it happens)."""
+    if len(X_sample) == 0:
+        return float("nan")
+    idx = np.random.RandomState(RANDOM_STATE).randint(0, len(X_sample), n_trials)
+    rows = X_sample[idx]
+    start = time.perf_counter()
+    for row in rows:
+        predict_fn(row.reshape(1, -1))
+    elapsed = time.perf_counter() - start
+    return (elapsed / n_trials) * 1000.0
+
+
+def train_isolation_forest(X_train: np.ndarray):
+    t0 = time.perf_counter()
+    model = IsolationForest(
+        n_estimators=N_ESTIMATORS,
+        contamination=CONTAMINATION,
+        random_state=RANDOM_STATE,
+        max_samples=min(256, len(X_train)),
+    )
+    model.fit(X_train)
+    train_time = time.perf_counter() - t0
+    predict_fn = lambda x: (model.predict(x) == -1).astype(int)
+    return model, predict_fn, train_time
+
+
+def train_one_class_svm(X_train: np.ndarray):
+    scaler = StandardScaler().fit(X_train)
+    X_scaled = scaler.transform(X_train)
+    t0 = time.perf_counter()
+    model = OneClassSVM(kernel="rbf", nu=CONTAMINATION, gamma="scale")
+    model.fit(X_scaled)
+    train_time = time.perf_counter() - t0
+    predict_fn = lambda x: (model.predict(scaler.transform(x)) == -1).astype(int)
+    # bundle scaler with model for size measurement
+    bundle = {"model": model, "scaler": scaler}
+    return bundle, predict_fn, train_time
+
+
+def train_autoencoder(X_train: np.ndarray):
+    """Compact bottleneck autoencoder (8->4->8) via MLPRegressor.
+    Anomaly score = reconstruction error; threshold set at the
+    CONTAMINATION-th percentile of TRAIN reconstruction error (unsupervised,
+    no peeking at test labels)."""
+    scaler = StandardScaler().fit(X_train)
+    X_scaled = scaler.transform(X_train)
+    t0 = time.perf_counter()
+    model = MLPRegressor(
+        hidden_layer_sizes=(4,),          # bottleneck: 8 -> 4 -> 8
+        activation="relu",
+        max_iter=500,
+        random_state=RANDOM_STATE,
+        early_stopping=True,
+    )
+    model.fit(X_scaled, X_scaled)  # reconstruct the input
+    train_time = time.perf_counter() - t0
+
+    train_recon_err = np.mean((model.predict(X_scaled) - X_scaled) ** 2, axis=1)
+    threshold = np.percentile(train_recon_err, 100 * (1 - CONTAMINATION))
+
+    def predict_fn(x_raw: np.ndarray) -> np.ndarray:
+        x_scaled = scaler.transform(x_raw)
+        recon = model.predict(x_scaled)
+        err = np.mean((recon - x_scaled) ** 2, axis=1)
+        return (err > threshold).astype(int)
+
+    bundle = {"model": model, "scaler": scaler, "threshold": threshold}
+    return bundle, predict_fn, train_time
+
+
+# ---------------------------------------------------------------------------
+# Main
+# ---------------------------------------------------------------------------
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Resource-efficiency benchmark: IsolationForest vs OC-SVM vs Autoencoder.")
+    parser.add_argument("--data", default=str(_DEFAULT_DATA), metavar="CSV")
+    parser.add_argument("--models-dir", default=str(_DEFAULT_MODELS_DIR), metavar="DIR")
+    args = parser.parse_args()
+
+    DATA_PATH = Path(args.data)
+    MODELS_DIR = Path(args.models_dir)
+    MODELS_DIR.mkdir(parents=True, exist_ok=True)
+
+    if not DATA_PATH.exists():
+        print(f"ERROR: Dataset not found at {DATA_PATH}", file=sys.stderr)
+        sys.exit(1)
+
+    print(f"Loading: {DATA_PATH}")
+    df = pd.read_csv(DATA_PATH)
+    df["role"] = df["role"].astype(str).str.strip().str.lower()
+
+    missing = [f for f in FEATURE_ORDER if f not in df.columns]
+    if missing:
+        print(f"ERROR: Missing feature columns: {missing}", file=sys.stderr)
+        sys.exit(1)
+    if "is_anomaly" not in df.columns:
+        print("ERROR: 'is_anomaly' column required.", file=sys.stderr)
+        sys.exit(1)
+
+    X_all = df[FEATURE_ORDER].to_numpy(dtype=float)
+    y_all = df["is_anomaly"].to_numpy(dtype=int)
+
+    X_train, X_test, y_train, y_test = train_test_split(
+        X_all, y_all, test_size=TEST_SIZE, random_state=RANDOM_STATE, stratify=y_all,
+    )
+
+    print(f"Train: {len(X_train):,} rows | Test: {len(X_test):,} rows "
+          f"({int(y_test.sum())} anomalies, {y_test.mean()*100:.1f}%)\n")
+
+    trainers = {
+        "IsolationForest (current)": (train_isolation_forest, MODELS_DIR / "isoforest_bench.pkl"),
+        "One-Class SVM": (train_one_class_svm, MODELS_DIR / "ocsvm_bench.pkl"),
+        "Compact Autoencoder (8-4-8)": (train_autoencoder, MODELS_DIR / "autoencoder_bench.pkl"),
+    }
+
+    rows = []
+    for name, (trainer_fn, pkl_path) in trainers.items():
+        print(f"Training: {name} ...")
+        tracemalloc.start()
+        model_obj, predict_fn, train_time = trainer_fn(X_train)
+        _, peak_mem = tracemalloc.get_traced_memory()
+        tracemalloc.stop()
+        peak_mem_kb = peak_mem / 1024.0
+
+        y_pred = predict_fn(X_test)
+        metrics = compute_metrics(y_test, y_pred)
+
+        model_size_kb = measure_model_size_kb(model_obj, pkl_path)
+        latency_ms = measure_inference_latency_ms(predict_fn, X_test, N_LATENCY_TRIALS)
+
+        rows.append({
+            "name": name, "train_time": train_time, "peak_mem_kb": peak_mem_kb,
+            "model_size_kb": model_size_kb, "latency_ms": latency_ms, **metrics,
+        })
+        print(f"  done in {train_time:.2f}s, model size {model_size_kb:.1f} KB\n")
+
+    # -----------------------------------------------------------------------
+    # Report
+    # -----------------------------------------------------------------------
+    SEP = "=" * 118
+    print(SEP)
+    print("  RESOURCE-EFFICIENCY BENCHMARK: Accuracy vs Deployment Cost")
+    print(SEP)
+    header = (f"  {'Model':<28} {'Prec':>7} {'Rec':>7} {'F1':>7} {'FPR':>7}   "
+              f"{'TrainTime(s)':>13} {'PeakMem(KB)':>12} {'ModelSize(KB)':>14} {'Latency(ms/pred)':>17}")
+    print(header)
+    print("-" * 118)
+    for r in rows:
+        print(f"  {r['name']:<28} {fmt_pct(r['precision'])} {fmt_pct(r['recall'])} "
+              f"{fmt_pct(r['f1'])} {fmt_pct(r['fpr'])}   "
+              f"{r['train_time']:13.3f} {r['peak_mem_kb']:12.1f} "
+              f"{fmt_kb(r['model_size_kb'])} {fmt_ms(r['latency_ms'])}")
+    print(SEP)
+    print()
+    print("  Interpretation: if IsolationForest matches OC-SVM/Autoencoder on F1 while")
+    print("  using less memory, disk, and per-prediction time, that supports the thesis")
+    print("  that it -not heavier models pushed in recent literature- is the right choice")
+    print("  for single-server clinic deployments. If it does NOT match on F1, that is")
+    print("  also a valid, reportable finding -do not discard it.")
+    print()
+
+
+if __name__ == "__main__":
+    main()
